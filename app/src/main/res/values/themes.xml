<resources>
    <!-- Base application theme. -->
    <style name="Theme.StudyCafe" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/brown</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/light_brown</item>
        <item name="colorOnSecondary">@color/white</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/brown</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- TimePicker Theme -->
    <style name="Theme.StudyCafe.TimePicker" parent="Theme.Material3.Light.Dialog">
        <item name="colorAccent">@color/brown</item>
        <item name="android:textColorPrimary">@color/dark_brown</item>
    </style>
</resources>
