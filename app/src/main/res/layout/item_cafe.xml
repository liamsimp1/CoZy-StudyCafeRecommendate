<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:layout_marginHorizontal="4dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/brown"
    app:strokeWidth="1dp"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/default_cafe_name"
                    android:textColor="@color/brown"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_category"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/default_category"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tv_distance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/default_distance"
                    android:textColor="@color/gray"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_score"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/ic_coffee"
                android:backgroundTint="@color/brown"
                android:gravity="center"
                android:text="@string/default_score"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="10dp"
            android:background="@color/light_gray" />

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2">

            <TextView
                android:id="@+id/tv_wifi"
                android:layout_width="0dp"
                android:layout_columnWeight="1"
                android:text="WiFi"
                android:textSize="12sp"
                android:textColor="@color/gray" />

            <TextView
                android:id="@+id/tv_price"
                android:layout_width="0dp"
                android:layout_columnWeight="1"
                android:text="Harga"
                android:textSize="12sp"
                android:textColor="@color/gray" />

            <TextView
                android:id="@+id/tv_comfort"
                android:layout_width="0dp"
                android:layout_columnWeight="1"
                android:layout_marginTop="4dp"
                android:text="Kenyamanan"
                android:textColor="@color/gray"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tv_outlets"
                android:layout_width="0dp"
                android:layout_columnWeight="1"
                android:layout_marginTop="4dp"
                android:text="Stop Kontak"
                android:textColor="@color/gray"
                android:textSize="12sp" />
        </GridLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
