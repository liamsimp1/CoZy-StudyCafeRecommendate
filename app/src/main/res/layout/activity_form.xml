<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/white">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/iv_back"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_back"
                    app:tint="@color/dark_brown"
                    android:contentDescription="Kembali" />

                <TextView
                    android:id="@+id/tv_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="16dp"
                    android:text="Tambah Cafe"
                    android:textColor="@color/dark_brown"
                    android:textSize="22sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="20dp"
                android:background="@color/light_gray" />

            <!-- Nama Cafe -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:hint="Nama Cafe"
                app:boxStrokeColor="@color/brown"
                app:hintTextColor="@color/dark_brown"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:textColor="@color/dark_brown" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Search Address (Google Maps style) -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_search"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="Cari Alamat (Ketik &amp; Klik Icon)"
                app:boxStrokeColor="@color/brown"
                app:hintTextColor="@color/dark_brown"
                app:endIconMode="custom"
                app:endIconDrawable="@drawable/ic_search"
                app:endIconTint="@color/brown"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_search_address"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:imeOptions="actionSearch"
                    android:textColor="@color/dark_brown" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Alamat Lengkap (Auto Filled kalo udh pencet search bar) -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="Alamat Lengkap"
                app:boxStrokeColor="@color/brown"
                app:hintTextColor="@color/dark_brown"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_address"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textMultiLine"
                    android:minLines="2"
                    android:gravity="top"
                    android:textColor="@color/dark_brown" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Jam Operasional -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:hint="Jam Buka"
                    app:boxStrokeColor="@color/brown"
                    app:hintTextColor="@color/dark_brown"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_open_time"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="time"
                        android:textColor="@color/dark_brown" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Jam Tutup"
                    app:boxStrokeColor="@color/brown"
                    app:hintTextColor="@color/dark_brown"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_close_time"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="time"
                        android:textColor="@color/dark_brown" />

                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="32dp"
                android:background="@color/light_gray" />

            <!-- WiFi Slider -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="Kecepatan WiFi (Mbps)"
                android:textColor="@color/dark_brown"
                android:textStyle="bold"
                android:textSize="14sp" />

            <SeekBar
                android:id="@+id/sb_wifi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:max="100"
                android:progress="50"
                android:progressTint="@color/brown"
                android:thumbTint="@color/brown" />

            <TextView
                android:id="@+id/tv_wifi_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="50 Mbps"
                android:textSize="12sp"
                android:textColor="@color/gray"
                android:textAlignment="center" />

            <!-- Kebisingan Slider -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Tingkat Kebisingan"
                android:textColor="@color/dark_brown"
                android:textStyle="bold"
                android:textSize="14sp" />

            <SeekBar
                android:id="@+id/sb_noise"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:max="100"
                android:progress="20"
                android:progressTint="@color/brown"
                android:thumbTint="@color/brown" />

            <TextView
                android:id="@+id/tv_noise_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="20"
                android:textSize="12sp"
                android:textColor="@color/gray"
                android:textAlignment="center" />

            <!-- Kenyamanan Slider -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Kenyamanan Kursi (0-10)"
                android:textColor="@color/dark_brown"
                android:textStyle="bold"
                android:textSize="14sp" />

            <SeekBar
                android:id="@+id/sb_comfort"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:max="10"
                android:progress="8"
                android:progressTint="@color/brown"
                android:thumbTint="@color/brown" />

            <TextView
                android:id="@+id/tv_comfort_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="8/10"
                android:textSize="12sp"
                android:textColor="@color/gray"
                android:textAlignment="center" />

            <!-- Harga Slider -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Harga Rata-rata (ribu)"
                android:textColor="@color/dark_brown"
                android:textStyle="bold"
                android:textSize="14sp" />

            <SeekBar
                android:id="@+id/sb_price"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:max="100"
                android:progress="35"
                android:progressTint="@color/brown"
                android:thumbTint="@color/brown" />

            <TextView
                android:id="@+id/tv_price_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Rp 35.000"
                android:textSize="12sp"
                android:textColor="@color/gray"
                android:textAlignment="center" />

            <!-- Stop Kontak Slider -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Jumlah Stop Kontak"
                android:textColor="@color/dark_brown"
                android:textStyle="bold"
                android:textSize="14sp" />

            <SeekBar
                android:id="@+id/sb_outlets"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:max="10"
                android:progress="8"
                android:progressTint="@color/brown"
                android:thumbTint="@color/brown" />

            <TextView
                android:id="@+id/tv_outlets_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="8"
                android:textSize="12sp"
                android:textColor="@color/gray"
                android:textAlignment="center" />

            <Button
                android:id="@+id/btn_simpan"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="48dp"
                android:layout_marginBottom="32dp"
                android:backgroundTint="@color/dark_brown"
                android:text="SIMPAN DATA CAFE"
                android:textColor="@color/white"
                android:textStyle="bold"
                app:cornerRadius="16dp" />

        </LinearLayout>
    </ScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/light_gray" />

    <!-- Bottom Navigation -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        app:itemIconTint="@color/brown"
        app:itemTextColor="@color/brown"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_nav_menu"
        app:elevation="0dp" />

</LinearLayout>
